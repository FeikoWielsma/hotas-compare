---
import BaseLayout from '../layouts/BaseLayout.astro';
import CatalogFilter from '../components/CatalogFilter.svelte';
import { getCatalogItems } from '../lib/catalog';
import { cardItem } from '../lib/catalog-ui';
const items = await getCatalogItems();
const brandCount = new Set(items.map((item) => item.brand)).size;
---

<BaseLayout title="Flight sim hardware, compared" pageSearch>
  <CatalogFilter client:load initialItems={items.map(cardItem)} {brandCount} />
</BaseLayout>

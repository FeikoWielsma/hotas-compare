---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404 — Page not found" description="This page could not be found. Return to the hardware catalog, compare flight controls or find your next setup." noindex>
  <section class="lost">
    <p class="eyebrow">404 · PAGE NOT FOUND</p>
    <div class="number" aria-hidden="true">404</div>
    <h1>This page isn’t in the catalog.</h1>
    <p class="message">The address may have changed, or the page may no longer be available. Pick up where you left off.</p>
    <nav aria-label="Helpful pages"><a class="primary" href="/">Browse the catalog <span aria-hidden="true">↗</span></a><a href="/compare">Compare hardware</a><a href="/wizard">Find a setup</a><a href="/brands">Browse brands</a></nav>
  </section>
</BaseLayout>
<style>
  .lost{max-width:760px;margin:clamp(2rem,8vw,6rem) auto;text-align:center;padding:clamp(1.5rem,5vw,3rem);border:1px solid var(--color-rule,var(--border-cockpit));background:var(--color-surface,var(--bg-panel))}.eyebrow{font-size:.875rem;color:var(--color-muted,var(--text-secondary))}.number{font:700 clamp(5rem,18vw,10rem)/.9 var(--font-display,'Barlow Condensed',sans-serif);color:var(--color-accent,var(--accent-amber));margin:1rem 0}.lost h1{font:700 clamp(2.5rem,7vw,4rem)/.98 var(--font-display,'Barlow Condensed',sans-serif);color:var(--color-ink,var(--text-primary));margin:0}.message{color:var(--color-muted,var(--text-secondary));max-width:540px;margin:1.25rem auto;line-height:1.7}nav{display:flex;flex-wrap:wrap;justify-content:center;gap:.75rem;margin:2rem 0 0}nav a{padding:.8rem 1.2rem;border:1px solid var(--color-rule,var(--border-cockpit));text-decoration:none;font-size:.9rem;color:var(--color-ink,var(--text-primary))}nav a:hover{border-color:var(--color-accent,var(--accent-amber))}nav .primary{background:var(--color-accent,var(--accent-amber));color:var(--color-surface);border-color:var(--color-accent,var(--accent-amber))}
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import TierList from '../components/TierList.svelte';
import { getCollection } from 'astro:content';
import { getCatalogItems } from '../lib/catalog';
import { productImageSrc } from '../lib/catalog-ui';
import { buildTierItems } from '../lib/fit-tiers';

const [catalog, components, families] = await Promise.all([getCatalogItems(), getCollection('components'), getCollection('families')]);
const data = new Map(components.map((entry) => [entry.id, entry.data]));
const familyOf = new Map(families.flatMap((family) => family.data.members.map((member) => [member.id, family.data.name] as const)));
// Variants are ranked as one entry; unreviewed parts start from the spec baseline.
const items = buildTierItems(catalog
  .filter((item) => item.item_type === 'component' && item.status !== 'discontinued')
  .map((item) => ({ id: item.id, brandName: item.brandName, image: productImageSrc(item.images[0]?.file), data: data.get(item.id)!, familyName: familyOf.get(item.id) })));
---
<BaseLayout title="Rank the hardware" image="/social/tiers.png" description="Make a tier list of flight sim sticks, throttles, yokes and pedals for your kind of flying, and share it to help tune our fit scores.">
  <header class="guide-header">
    <h1>Tier lists</h1>
    <p class="intro">Fit scores come from shared tier lists. Rank the parts you know for one kind of flying, then share the link.</p>
  </header>
  <TierList client:load {items} />
  <noscript>Enable JavaScript to make a tier list. You can also <a href="/">browse the hardware catalog</a>.</noscript>
</BaseLayout>
<style>
  .guide-header { position: relative; margin-top: 1rem; padding: 1.25rem 1.5rem 1.75rem; background: var(--color-navy); color: var(--color-on-navy); }
  .guide-header::after { content: ''; position: absolute; inset: auto 0 0; height: 7px; background: repeating-linear-gradient(120deg, var(--color-highlight) 0 26px, var(--color-on-navy) 26px 30px, var(--color-navy) 30px 40px); }
  h1 { font: 700 2rem/1 var(--font-display); letter-spacing: .01em; text-transform: uppercase; margin: 0; }
  .intro { font: .9375rem/1.6 var(--font-sans); max-width: 62ch; margin: .5rem 0 0; }
</style>

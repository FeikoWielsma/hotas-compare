---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const [brands,components,bundles]=await Promise.all([getCollection('brands'),getCollection('components'),getCollection('bundles')]);
---
<BaseLayout title="Flight sim brands"><div class="wrap"><p class="eyebrow">MANUFACTURERS</p><h1>Flight sim brands</h1><div class="grid">{brands.map(({id,data:b})=><a class="card" href={`/brands/${id}`}><div class="top"><h2>{b.name}</h2>{b.former_names.map(name=><span class="pill">Formerly {name}</span>)}</div><p>{b.country ?? 'Country not listed'}{b.website && <> · <span class="site">Official website ↗</span></>}</p><p class="counts"><b>{components.filter(x=>x.data.brand===id).length}</b> components <b>{bundles.filter(x=>x.data.brand===id).length}</b> bundles</p></a>)}</div></div></BaseLayout>
<style>.wrap{max-width:1100px;margin:auto}.eyebrow{font:.7rem var(--font-mono);letter-spacing:.12em;color:var(--accent-amber)}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:1rem}.card{display:block;padding:1.3rem;border:1px solid var(--border-cockpit);background:var(--bg-panel);text-decoration:none;border-radius:4px}.card:hover{border-color:var(--accent-amber)}.top{display:flex;align-items:center;gap:.5rem;flex-wrap:wrap}.top h2{margin:0}.pill{padding:.2rem .45rem;border:1px solid var(--border-cockpit);border-radius:20px;color:var(--text-secondary);font-size:.7rem}.card p{color:var(--text-secondary)}.site{color:var(--accent-amber)}.counts{display:flex;gap:.4rem;align-items:center;font-size:.8rem}.counts b{color:var(--text-primary);margin-left:.5rem}</style>

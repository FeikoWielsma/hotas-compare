---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { productImageSrc } from '../../lib/catalog-ui';
const [components,bundles]=await Promise.all([getCollection('components'),getCollection('bundles')]);
export async function getStaticPaths(){const brands=await getCollection('brands');return brands.map(({id,data})=>({params:{brand:id},props:{brand:{id,data}}}));}
const {brand:entry}=Astro.props;const {id,data:b}=entry;
const ownComponents=components.filter(x=>x.data.brand===id);const ownBundles=bundles.filter(x=>x.data.brand===id);
const money=(item:any)=>{const p=item.prices.find((x:any)=>x.region==='EU')??item.prices[0];return p?new Intl.NumberFormat('en',{style:'currency',currency:p.currency}).format(p.amount):'Price unavailable'};
const jsonLd = { '@context': 'https://schema.org', '@type': 'Brand', name: b.name, url: b.website ?? new URL(Astro.url.pathname, Astro.site).href, ...(b.website ? { sameAs: b.website } : {}) };
---
<BaseLayout title={b.name} jsonLd={jsonLd} description={`${b.name} flight simulation hardware, products and shipping notes.`}><div class="wrap"><nav class="crumb"><a href="/">Home</a> / <a href="/brands">Brands</a> / {b.name}</nav><header><p class="eyebrow">BRAND PROFILE</p><h1>{b.name}</h1>{b.former_names.map(n=><span class="pill">Formerly {n}</span>)}<p>{b.country ?? 'Country of origin not listed'}{b.website && <> · <a href={b.website} rel="external noopener">Official website ↗</a></>}</p></header><section class="card"><h2>Shipping &amp; landed cost</h2><div class="notes">{(['EU','UK','US'] as const).map(r=><div><b>{r}</b><p>{b.landed_cost_notes[r] ?? 'No regional delivery notes available.'}</p></div>)}</div></section><section><h2>Components made by {b.name}</h2>{ownComponents.length?<div class="grid">{ownComponents.map(({id:ref,data:c})=><a class="card product" href={`/components/${ref}`}>{productImageSrc(c.images[0]?.file) && <img src={productImageSrc(c.images[0].file)!} alt="" />}<span class="eyebrow">{c.category.replaceAll('_',' ')}</span><h3>{c.name}</h3><p>{c.hardware?.gimbal ?? c.hardware?.sensor ?? 'Specifications available on product page'}</p><b>{money(c)}</b></a>)}</div>:<p>No component listings yet.</p>}</section><section><h2>Bundles sold by {b.name}</h2>{ownBundles.length?<div class="grid">{ownBundles.map(({id:ref,data:item})=><a class="card product" href={`/bundles/${ref}`}>{productImageSrc(item.images[0]?.file) && <img src={productImageSrc(item.images[0].file)!} alt="" />}<span class="eyebrow">{item.category.replaceAll('_',' ')}</span><h3>{item.name}</h3><p>{item.components.length} included components</p><b>{money(item)}</b></a>)}</div>:<p>No bundle listings yet.</p>}</section></div></BaseLayout>
<style>.wrap{max-width:1100px;margin:auto}.crumb{font:.75rem var(--font-mono);color:var(--text-secondary)}.crumb a,header a{color:var(--accent-amber)}header{padding:1.5rem 0}.eyebrow{font:.7rem var(--font-mono);letter-spacing:.1em;color:var(--accent-amber)}.pill{display:inline-block;margin-right:.4rem;padding:.2rem .5rem;border:1px solid var(--border-cockpit);border-radius:30px;color:var(--text-secondary);font-size:.75rem}.card{padding:1.25rem;border:1px solid var(--border-cockpit);background:var(--bg-panel);border-radius:4px;margin-bottom:1rem}.card h2{margin:0 0 1rem}.notes{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.notes p{color:var(--text-secondary)}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:1rem}.product{display:block;text-decoration:none}.product:hover{border-color:var(--accent-amber)}.product img{width:100%;aspect-ratio:4/3;object-fit:contain;background:#f4f1ea;border-radius:3px;margin-bottom:.75rem}.product h3{margin:.5rem 0}.product p{color:var(--text-secondary)}@media(max-width:700px){.notes{grid-template-columns:1fr}}</style>

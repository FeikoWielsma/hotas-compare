---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompareView from '../components/CompareView.svelte';
import { getCatalogItems } from '../lib/catalog';
const items = await getCatalogItems();
---
<BaseLayout title="Compare hardware" noindex>
  <p class="eyebrow">COCKPIT / COMPARISON MATRIX</p>
  <h1>Compare your <span>loadout.</span></h1>
  <p class="intro">Up to four pieces of hardware. Every axis, every input, side by side.</p>
  <CompareView client:load initialItems={items} />
</BaseLayout>
<style>.eyebrow { font: .7rem var(--font-mono); color: var(--hud-cyan); letter-spacing: .15em; } h1 span { color: var(--accent-amber); } .intro { color: var(--text-secondary); margin-bottom: 2rem; }</style>

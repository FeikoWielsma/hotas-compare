---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductHero from '../../components/detail/ProductHero.astro';
import Verdict from '../../components/detail/Verdict.astro';
import UseCaseFit from '../../components/detail/UseCaseFit.astro';
import Reviews from '../../components/detail/Reviews.astro';
import PriceTable from '../../components/detail/PriceTable.astro';
import UpgradePaths from '../../components/detail/UpgradePaths.astro';
import Explain from '../../components/Explain.svelte';
import { compatibleParts, resolveUpgradePaths } from '../../lib/upgrades';
import { needsPedals } from '../../lib/catalog';
import { gimbalGlossaryKey, gimbalLabels } from '../../lib/glossary';
import ControlInventory from '../../components/ControlInventory.svelte';
import { productJsonLd } from '../../lib/structured-data';
import { deriveComponentStats, deriveControlsSummary } from '../../lib/derive';
import { inventoryComplete } from '../../lib/control-inventory';
import { humanize, yesNoUnknown } from '../../lib/labels';
import { overallVerdict, keySpecs, isDefaultFit } from '../../lib/detail';
const [brands, mounts, allComponents, allBundles] = await Promise.all([getCollection('brands'), getCollection('mount_standards'), getCollection('components'), getCollection('bundles')]);
const componentMap = new Map(allComponents.map(x => [x.id, x.data]));
const bundleMap = new Map(allBundles.map(x => [x.id, x.data]));
const brandMap = new Map(brands.map(x => [x.id, x.data]));
const mountMap = new Map(mounts.map(x => [x.id, x.data]));
export async function getStaticPaths() { const components = await getCollection('components'); return components.map(({id,data}) => ({params:{slug:id},props:{component:{id,data}}})); }
const { component: entry } = Astro.props;
const { id, data: c } = entry;
const brand = brandMap.get(c.brand);
const brandName = brand?.name ?? c.brand;
const stats = deriveComponentStats(c);
const summary = deriveControlsSummary(c.controls);
const sourceLabel = (source: string) => { try { return new URL(source).hostname.replace(/^www\./, ''); } catch { return 'Source'; } };
const description = `${brandName} ${c.name}: specifications, controls, compatibility and regional pricing.`;
const jsonLd = productJsonLd(c, brandName, new URL(Astro.url.pathname, Astro.site), description);
const h = c.hardware;
const damperAddon = h?.damper_addon ? componentMap.get(h.damper_addon) : null;
const damperText = h?.damper === 'built_in' ? 'Built-in' : h?.damper === 'optional' ? 'Optional' : h?.damper === 'none' ? 'None' : '';
const axisCount = stats.totalAxes || h?.axis_count;
const specs = keySpecs({
  axes: axisCount ? String(axisCount) : h?.axis_count === 0 ? '0' : null,
  inputs: c.category === 'pedals' ? null : summary.totalLogicalButtons || inventoryComplete([c]) ? String(summary.totalLogicalButtons) : null,
  sensor: h?.sensor, gimbal: h?.gimbal, throw: h?.throw_deg, weight: c.physical?.weight_g,
  connection: c.connectivity.standalone_usb == null ? null : c.connectivity.standalone_usb ? (c.connectivity.usb && c.connectivity.usb.length < 12 ? humanize(c.connectivity.usb) : 'Standalone USB') : 'Via compatible base',
  verdict: c.verdict ? overallVerdict(c.verdict) : null,
});
const groups = [
  { title: 'Mechanics', rows: [
    ['Gimbal type', h?.gimbal_type ? gimbalLabels[h.gimbal_type] : ''], ['Gimbal', humanize(h?.gimbal)], ['Primary sensor', humanize(h?.sensor)], ['Throw', h?.throw_deg != null ? `${h.throw_deg}°` : ''],
    ['Force adjustable', yesNoUnknown(h?.force_adjustable)], ['Swappable cams', yesNoUnknown(h?.cams_swappable)],
    ['Damping', humanize(h?.damping) || damperText], ['Extension support', yesNoUnknown(h?.extension_support)],
  ] },
  { title: 'Physical', rows: [
    ['Weight', c.physical?.weight_g != null ? `${c.physical.weight_g.toLocaleString('en')} g` : ''],
    ['Dimensions', c.physical?.dimensions_mm ? `${c.physical.dimensions_mm.join(' × ')} mm` : ''],
    ['Materials', c.physical?.materials?.map(humanize).join(', ')],
  ] },
  { title: 'Connection & software', rows: [
    ['USB', humanize(c.connectivity.usb)], ['Works standalone', yesNoUnknown(c.connectivity.standalone_usb)], ['Configuration software', c.software],
  ] },
].map(g => ({ ...g, known: g.rows.filter(([, v]) => v), missing: g.rows.filter(([, v]) => !v).map(([l]) => l) }));
const provides = c.mount?.provides ? mountMap.get(c.mount.provides) : null;
const accepts = (c.mount?.accepts ?? []).map(x => ({ id: x, data: mountMap.get(x) }));
const showFit = !isDefaultFit(c.use_case_fit);
const upgrades = resolveUpgradePaths(id, c.upgrade_paths, componentMap, bundleMap);
const fits = compatibleParts(c, componentMap, mountMap);
const pedals = needsPedals(c.category, [c]);
const showUpgrades = upgrades.length > 0 || (fits?.items.length ?? 0) > 0 || pedals;
const sections = [
  c.verdict && { href: '#verdict', label: 'Verdict' }, { href: '#controls', label: 'Controls' }, showFit && { href: '#fit', label: 'Flying-style fit' },
  { href: '#specs', label: 'Specifications' }, showUpgrades && { href: '#upgrades', label: 'Upgrade paths' }, { href: '#pricing', label: 'Pricing' }, c.external_reviews.length && { href: '#reviews', label: 'Reviews' },
].filter(Boolean) as { href: string; label: string }[];
---
<BaseLayout title={c.name} description={description} image={c.images[0]?.file} jsonLd={jsonLd}>
<div class="page">
  <ProductHero id={id} name={c.name} brand={c.brand} brandName={brandName} category={c.category} status={c.status} verification={c.verification}
    releaseYear={c.release_year} handedness={c.handedness} images={c.images} prices={c.prices} notes={brand?.landed_cost_notes} compatibility={c.platform_compatibility}
    specs={specs} crumb={{ href: '/#hardware', label: 'Components' }} sections={sections} />
  {c.verdict && <Verdict verdict={c.verdict} />}
  <div id="controls" class="anchor"><ControlInventory sections={[c]} /></div>
  {showFit && <UseCaseFit fit={c.use_case_fit} />}
  <section id="specs" class="specs" aria-labelledby="specs-title">
    <p class="kicker">Specifications</p><h2 id="specs-title">The details</h2>
    <div class="sheet">
      {groups.map(g => <div class="group"><h3>{g.title}</h3>{g.known.length ? <dl>{g.known.map(([l, v]) => <div><dt>{l}</dt><dd>{v}{l === 'Gimbal type' && h?.gimbal_type && <Explain term={gimbalGlossaryKey[h.gimbal_type]} />}{l === 'Damping' && h?.damper_addon && damperAddon && <> (<a href={`/components/${h.damper_addon}`}>{damperAddon.name}</a>)</>}</dd></div>)}</dl> : <p class="none">Not yet documented.</p>}{g.known.length > 0 && g.missing.length > 0 && <p class="missing">Not documented: {g.missing.join(', ').toLowerCase()}</p>}</div>)}
      <div class="group"><h3>Mounting</h3>
        {provides || accepts.length ? <dl>
          {provides && <div><dt>Provides</dt><dd>{provides.name}<small>{provides.description}</small></dd></div>}
          {accepts.map(a => <div><dt>Accepts</dt><dd>{a.data?.name ?? a.id}{a.data?.description && <small>{a.data.description}</small>}</dd></div>)}
        </dl> : <p class="none">No mount standard documented.</p>}
      </div>
    </div>
    {h?.axes && h.axes.length > 0 && <div class="axes"><h3>Axes</h3><table><thead><tr><th>Axis</th><th>Sensor</th><th>Resolution</th></tr></thead><tbody>{h.axes.map(a => <tr><td>{humanize(a.name)}</td><td>{humanize(a.sensor) || '—'}</td><td>{a.resolution_bits ? `${a.resolution_bits}-bit` : '—'}</td></tr>)}</tbody></table>{h.axis_count != null && h.axis_count !== h.axes.length && <p class="missing">The manufacturer lists {h.axis_count} axes; {h.axes.length} are individually documented.</p>}</div>}
  </section>
  <UpgradePaths upgrades={upgrades} fits={fits} needsPedals={pedals} />
  <PriceTable prices={c.prices} notes={brand?.landed_cost_notes} />
  {c.external_reviews.length > 0 && <Reviews reviews={c.external_reviews} />}
  {c.sources.length > 0 && <details class="references"><summary>References ({c.sources.length})</summary><ul>{c.sources.map((source: string) => <li><a href={source} rel="external noopener">{sourceLabel(source)}</a></li>)}</ul></details>}
</div>
</BaseLayout>
<style>
  .page { max-width: 1240px; margin: auto; min-width: 0; }
  .anchor, section { scroll-margin-top: 4rem; }
  .page > :global(section), .anchor { margin-bottom: 2.5rem; }
  .kicker { margin: 0; color: var(--color-accent); font-size: .8rem; font-weight: 600; }
  .specs h2 { margin: .25rem 0 1.25rem; font-size: clamp(1.9rem, 3vw, 2.5rem); text-transform: uppercase; }
  .specs { padding-top: 1.5rem; border-top: 1px solid var(--color-rule); }
  .sheet { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .group { padding: 1.25rem; border: 1px solid var(--color-rule); background: var(--color-surface); min-width: 0; }
  h3 { margin: 0 0 .75rem; font: 700 .8rem var(--font-sans); letter-spacing: .08em; text-transform: uppercase; color: var(--color-muted); }
  dl { display: grid; margin: 0; } dl > div { display: grid; grid-template-columns: 11rem minmax(0, 1fr); gap: 1rem; padding: .55rem 0; border-top: 1px solid var(--color-rule); font-size: .9rem; } dl > div:first-child { border-top: 0; padding-top: 0; }
  dt { color: var(--color-muted); } dd { margin: 0; overflow-wrap: anywhere; } dd small { display: block; margin-top: .25rem; color: var(--color-muted); font-size: .8rem; line-height: 1.55; }
  dd a { color: var(--color-accent); }
  .none, .missing { margin: .5rem 0 0; color: var(--color-muted); font-size: .8rem; } .none { margin: 0; }
  .axes { margin-top: 1rem; padding: 1.25rem; border: 1px solid var(--color-rule); background: var(--color-surface); overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: .875rem; } th, td { text-align: left; padding: .55rem .75rem .55rem 0; border-bottom: 1px solid var(--color-rule); } th { font-size: .75rem; font-weight: 600; color: var(--color-muted); } tr:last-child td { border-bottom: 0; }
  .references { padding: 1rem 1.25rem; border: 1px solid var(--color-rule); background: var(--color-surface); font-size: .875rem; } .references summary { cursor: pointer; font-weight: 600; } .references ul { columns: 2; margin: .75rem 0 0; } .references a { color: var(--color-accent); overflow-wrap: anywhere; }
  @media (max-width: 800px) { .sheet { grid-template-columns: 1fr; } dl > div { grid-template-columns: 9rem minmax(0, 1fr); } .references ul { columns: 1; } }
</style>

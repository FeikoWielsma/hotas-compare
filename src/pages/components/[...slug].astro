---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { productJsonLd } from '../../lib/structured-data';
import { productImageSrc } from '../../lib/catalog-ui';
import AddCompare from '../../components/AddCompare.svelte';
import ControlInventory from '../../components/ControlInventory.svelte';
import { deriveComponentStats } from '../../lib/derive';
const [brands, mounts, reviewers] = await Promise.all([getCollection('brands'), getCollection('mount_standards'), getCollection('reviewers')]);
const brandMap = new Map(brands.map(x => [x.id, x.data]));
const mountMap = new Map(mounts.map(x => [x.id, x.data]));
const reviewerMap = new Map(reviewers.map(x => [x.id, x.data]));
export async function getStaticPaths() { const components = await getCollection('components'); return components.map(({id,data}) => ({params:{slug:id},props:{component:{id,data}}})); }
const { component: entry } = Astro.props;
const { id, data:c } = entry;
const brand = brandMap.get(c.brand);
const stats = deriveComponentStats(c);
const correction = `https://github.com/FeikoWielsma/hotas-compare/issues/new?title=Correction:+${encodeURIComponent(c.name)}&body=${encodeURIComponent(`Product: ${c.name}\nPage: /components/${id}\n\nWhat should be corrected?`)}`;
const money = (p:any) => new Intl.NumberFormat('en', {style:'currency',currency:p.currency}).format(p.amount);
const description = `${brand?.name ?? c.brand} ${c.name}: specifications, controls, compatibility and regional pricing.`;
const jsonLd = productJsonLd(c, brand?.name ?? c.brand, new URL(Astro.url.pathname, Astro.site), description);
const heroSrc = productImageSrc(c.images[0]?.file);
---
<BaseLayout title={c.name} description={description} image={c.images[0]?.file} jsonLd={jsonLd}>
<div class="page">
  <nav class="crumb"><a href="/">Home</a> / <a href="/components">Components</a> / <a href={`/brands/${c.brand}`}>{brand?.name ?? c.brand}</a> / {c.name}</nav>
  <header class="hero">{heroSrc && <figure class="shot"><img src={heroSrc} alt={c.images[0]?.caption ?? c.name} />{c.images[0]?.source && <figcaption><a href={c.images[0].source} rel="external noopener">Manufacturer photo</a></figcaption>}</figure>}<div><p class="eyebrow">{brand?.name ?? c.brand} / {c.category.replaceAll('_',' ')}</p><h1>{c.name}</h1><div class="pills"><a class="pill" href={`/brands/${c.brand}`}>{brand?.name ?? c.brand}</a><span class="pill">{c.category.replaceAll('_',' ')}</span><span class="pill">{c.status}</span><span class="pill">{c.verification}</span>{c.release_year && <span class="pill">Released {c.release_year}</span>}</div></div><div class="actions"><AddCompare id={id} client:load /><a class="button secondary" href={correction}>Suggest a correction</a></div></header>
  <ControlInventory sections={[c]} />
  <div class="grid">
    <section class="card"><h2>Hardware</h2><dl><dt>Gimbal</dt><dd>{c.hardware?.gimbal ?? 'Not specified'}</dd><dt>Sensor</dt><dd>{c.hardware?.sensor ?? 'Not specified'}</dd><dt>Axes</dt><dd>{c.hardware?.axes?.length ? <ul>{c.hardware.axes.map((a:any)=><li>{a.name}{a.resolution_bits ? ` — ${a.resolution_bits}-bit` : ''}{a.sensor ? `, ${a.sensor}` : ''}</li>)}</ul> : `${stats.totalAxes} axes estimated`}</dd><dt>Force adjustable</dt><dd>{c.hardware?.force_adjustable == null ? 'Not specified' : c.hardware.force_adjustable ? 'Yes' : 'No'}</dd><dt>Swappable cams</dt><dd>{c.hardware?.cams_swappable == null ? 'Not specified' : c.hardware.cams_swappable ? 'Yes' : 'No'}</dd><dt>Damping</dt><dd>{c.hardware?.damping ?? 'Not specified'}</dd><dt>Extension support</dt><dd>{c.hardware?.extension_support == null ? 'Not specified' : c.hardware.extension_support ? 'Yes' : 'No'}</dd><dt>Throw</dt><dd>{c.hardware?.throw_deg != null ? `${c.hardware.throw_deg}°` : 'Not specified'}</dd></dl></section>

    <section class="card"><h2>Mount compatibility</h2><p><b>Provides:</b> {c.mount?.provides ? (mountMap.get(c.mount.provides)?.name ?? c.mount.provides) : 'Not specified'}</p><p><b>Accepts:</b> {c.mount?.accepts?.length ? c.mount.accepts.map((x:string)=>mountMap.get(x)?.name ?? x).join(', ') : 'Not specified'}</p>{c.mount?.provides && <p>{mountMap.get(c.mount.provides)?.description ?? mountMap.get(c.mount.provides)?.physical_type}</p>}{c.mount?.accepts?.map((x:string)=><p>{mountMap.get(x)?.description}</p>)}</section>
    <section class="card"><h2>Physical &amp; software</h2><dl><dt>Weight</dt><dd>{c.physical?.weight_g != null ? `${c.physical.weight_g} g` : 'Not specified'}</dd><dt>Materials</dt><dd>{c.physical?.materials?.join(', ') || 'Not specified'}</dd><dt>USB</dt><dd>{c.connectivity?.usb ?? 'Not specified'}</dd><dt>Standalone USB</dt><dd>{c.connectivity?.standalone_usb ? 'Yes' : 'No'}</dd><dt>Configuration software</dt><dd>{c.software ?? 'Not specified'}</dd></dl></section>
  </div>
  <section class="card wide"><h2>Regional pricing</h2><div class="scroll"><table><thead><tr><th>Region</th><th>Currency</th><th>Price</th><th>VAT</th><th>Store</th><th>Verified</th><th>Freshness</th></tr></thead><tbody>{(['EU','UK','US'] as const).map(region=>{const p=c.prices.find((x:any)=>x.region===region);const age=p?Math.floor((Date.now()-new Date(p.verified).getTime())/86400000):0;return <tr><td>{region}</td><td>{p?.currency ?? '—'}</td><td>{p ? money(p) : '—'}</td><td>{p ? p.incl_vat?'Included':'Excluded' : '—'}</td><td>{p?.url ? <a href={p.url} rel="external noopener">{p.store}</a> : p?.store ?? '—'}</td><td>{p?.verified ?? '—'}</td><td>{p ? age>90 ? `Stale (${age}d)` : 'Current' : '—'}</td></tr>})}</tbody></table></div>{brand?.landed_cost_notes && <div class="notes">{(['EU','UK','US'] as const).map(r=>brand.landed_cost_notes[r] && <p><b>{r}:</b> {brand.landed_cost_notes[r]}</p>)}</div>}</section>
  {c.verdict && <section class="card wide"><h2>Editorial verdict</h2><p><b>{c.verdict.author}</b> {c.verdict.hands_on && <span class="pill">Hands-on</span>} {c.verdict.owned_hours != null && `· ${c.verdict.owned_hours} hours owned`}</p><p>{c.verdict.take}</p><div class="grid inner"><div><h3>Pros</h3><ul>{c.verdict.pros.map((x:string)=><li>{x}</li>)}</ul></div><div><h3>Cons</h3><ul>{c.verdict.cons.map((x:string)=><li>{x}</li>)}</ul></div></div><p>Great for: {c.verdict.great_for.map((x:string)=><span class="pill">{x}</span>)}</p><p>Skip if: {c.verdict.skip_if.map((x:string)=><span class="pill">{x}</span>)}</p><div class="scores">{Object.entries({Build:c.verdict.scores.build,Feel:c.verdict.scores.feel,Value:c.verdict.scores.value,Software:c.verdict.scores.software,'QC Support':c.verdict.scores.qc_support}).map(([label,value]:any)=><div><span>{label}</span><progress max="5" value={value}>{value}/5</progress><b>{value}/5</b></div>)}</div></section>}
  {c.external_reviews.length>0 && <section class="card wide"><h2>External reviews</h2><ul class="reviewlist">{c.external_reviews.map((r:any)=><li><a href={r.url} rel="external noopener">{reviewerMap.get(r.reviewer)?.name ?? r.reviewer}</a> <span class="pill">{reviewerMap.get(r.reviewer)?.platform ?? 'External review'}</span><span class="pill">{r.tag}</span><small>{r.date}</small><p>{r.summary}</p></li>)}</ul></section>}
  {c.sources.length>0 && <section class="card wide"><h2>Sources</h2><ul>{c.sources.map((source:string)=><li><a href={source} rel="external noopener">{source}</a></li>)}</ul></section>}
</div>
</BaseLayout>
<style>.page{max-width:1180px;margin:auto}.crumb,.eyebrow{color:var(--text-secondary);font:.75rem var(--font-mono)}.crumb a{color:var(--accent-amber)}.hero{display:flex;align-items:flex-start;justify-content:space-between;gap:1.5rem;padding:2rem 0}.shot{flex:0 0 240px;margin:0;background:#f4f1ea;border:1px solid var(--border-cockpit);border-radius:4px;overflow:hidden}.shot img{display:block;width:100%;aspect-ratio:1;object-fit:contain}.shot figcaption{padding:.45rem .7rem;background:var(--bg-panel);font:.65rem var(--font-mono)}.shot a{color:var(--accent-amber)}.hero > div:first-of-type{flex:1;min-width:0}.hero h1{margin:.4rem 0 1rem}.pills,.actions{display:flex;flex-wrap:wrap;gap:.5rem;align-items:center}.pill{display:inline-block;padding:.25rem .55rem;border:1px solid var(--border-cockpit);border-radius:99px;color:var(--text-secondary);font-size:.75rem;text-decoration:none}.button{padding:.7rem 1rem;border:1px solid var(--border-cockpit);border-radius:3px;text-decoration:none;font-size:.8rem}.secondary{color:var(--text-primary);background:var(--bg-panel)}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.card{padding:1.25rem;border:1px solid var(--border-cockpit);background:var(--bg-panel);border-radius:4px;margin-bottom:1rem}.card h2{margin:0 0 1rem}.card h3{margin:.5rem 0}.wide{margin-top:.5rem}.inner{grid-template-columns:1fr 1fr}.card dl{display:grid;grid-template-columns:minmax(130px,.7fr) 1.3fr;gap:.5rem 1rem;margin:0}.card dt{color:var(--text-secondary)}.card dd{margin:0}.controls,.reviewlist{padding-left:1.2rem}.totals{padding-top:.75rem;border-top:1px solid var(--border-cockpit);color:var(--text-secondary)}.scroll{overflow-x:auto}table{width:100%;border-collapse:collapse;font-size:.85rem}th,td{text-align:left;padding:.7rem;border-bottom:1px solid var(--border-cockpit);white-space:nowrap}th{color:var(--text-secondary);font:.7rem var(--font-mono);text-transform:uppercase}.notes{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;color:var(--text-secondary)}.scores{display:grid;gap:.6rem}.scores div{display:grid;grid-template-columns:100px 1fr 45px;gap:.75rem;align-items:center}progress{width:100%;accent-color:var(--accent-amber)}small{margin-left:.5rem;color:var(--text-muted)}@media(max-width:700px){.hero{align-items:flex-start;flex-direction:column}.shot{flex-basis:auto;width:min(100%,280px)}.grid,.notes{grid-template-columns:1fr}.card dl{grid-template-columns:1fr}.card dd{margin-bottom:.5rem}}</style>

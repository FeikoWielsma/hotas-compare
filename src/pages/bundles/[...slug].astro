---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { deriveComponentStats, deriveControlsSummary } from '../../lib/derive';
const [components,brands]=await Promise.all([getCollection('components'),getCollection('brands')]);
const brandMap=new Map(brands.map(x=>[x.id,x.data]));
export async function getStaticPaths(){const bundles=await getCollection('bundles');return bundles.map(({id,data})=>({params:{slug:id},props:{bundle:{id,data}}}));}
const {bundle:entry}=Astro.props;const {id,data:b}=entry;const brand=brandMap.get(b.brand);const included=b.components.map(ref=>components.find(x=>x.id===ref)).filter(Boolean);const stats=included.map(x=>deriveComponentStats(x!.data));const controls=deriveControlsSummary(included.flatMap(x=>x!.data.controls));const totalAxes=stats.reduce((n,s)=>n+s.totalAxes,0);
const correction=`https://github.com/FeikoWielsma/hotas-compare/issues/new?title=Correction:+${encodeURIComponent(b.name)}&body=${encodeURIComponent(`Bundle: ${b.name}\nPage: /bundles/${id}\n\nWhat should be corrected?`)}`;
const money=(p:any)=>new Intl.NumberFormat('en',{style:'currency',currency:p.currency}).format(p.amount);
---
<BaseLayout title={b.name} description={`${brand?.name ?? b.brand} ${b.name} bundle contents and regional prices.`}><div class="wrap"><nav class="crumb"><a href="/">Home</a> / <a href="/bundles">Bundles</a> / {b.name}</nav><header><p class="eyebrow">{brand?.name ?? b.brand} / {b.category.replaceAll('_',' ')}</p><h1>{b.name}</h1><div class="pills"><a class="pill" href={`/brands/${b.brand}`}>{brand?.name ?? b.brand}</a><span class="pill">{b.status}</span><span class="pill">{b.verification}</span></div></header><section><h2>Included components</h2><div class="grid">{included.map(({id:ref,data:c}:any)=><a class="card" href={`/components/${ref}`}><span class="eyebrow">{c.category.replaceAll('_',' ')}</span><h3>{c.name}</h3><p>{c.hardware?.gimbal ?? c.hardware?.sensor ?? 'Product specifications'}</p><span>View component ↗</span></a>)}</div></section><section class="card"><h2>Combined totals</h2><div class="totals"><div><strong>{controls.totalLogicalButtons}</strong><span>Logical buttons</span></div><div><strong>{totalAxes}</strong><span>Axes</span></div><div><strong>{controls.ministickCount}</strong><span>Ministicks</span></div></div></section><section class="card"><h2>Regional pricing</h2><div class="scroll"><table><thead><tr><th>Region</th><th>Currency</th><th>Price</th><th>VAT status</th><th>Store</th><th>Verified</th></tr></thead><tbody>{(['EU','UK','US'] as const).map(region=>{const p=b.prices.find((x:any)=>x.region===region);return <tr><td>{region}</td><td>{p?.currency ?? '—'}</td><td>{p?money(p):'—'}</td><td>{p?p.incl_vat?'Included':'Excluded':'—'}</td><td>{p?.url?<a href={p.url} rel="external noopener">{p.store}</a>:p?.store??'—'}</td><td>{p?.verified??'—'}</td></tr>})}</tbody></table></div></section>{b.verdict&&<section class="card"><h2>Editorial verdict</h2><p><b>{b.verdict.author}</b> {b.verdict.hands_on&&<span class="pill">Hands-on</span>}</p><p>{b.verdict.take}</p><div class="grid"><div><h3>Pros</h3><ul>{b.verdict.pros.map((x:string)=><li>{x}</li>)}</ul></div><div><h3>Cons</h3><ul>{b.verdict.cons.map((x:string)=><li>{x}</li>)}</ul></div></div></section>}<a class="button" href={correction}>Suggest a correction</a></div></BaseLayout>
<style>.wrap{max-width:1100px;margin:auto}.crumb{font:.75rem var(--font-mono);color:var(--text-secondary)}.crumb a{color:var(--accent-amber)}header{padding:1.5rem 0}.eyebrow{font:.7rem var(--font-mono);letter-spacing:.1em;color:var(--accent-amber)}.pills{display:flex;gap:.5rem}.pill{padding:.2rem .5rem;border:1px solid var(--border-cockpit);border-radius:30px;color:var(--text-secondary);font-size:.75rem;text-decoration:none}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:1rem}.card{padding:1.25rem;border:1px solid var(--border-cockpit);background:var(--bg-panel);border-radius:4px;margin-bottom:1rem}.card h2{margin:0 0 1rem}.card h3{margin:.5rem 0}.card a{color:var(--accent-amber)}.grid>a{display:block;text-decoration:none;color:var(--text-primary)}.grid>a:hover{border-color:var(--accent-amber)}.totals{display:flex;gap:3rem;flex-wrap:wrap}.totals div{display:grid}.totals strong{font:1.6rem var(--font-mono);color:var(--accent-amber)}.totals span{color:var(--text-secondary)}.scroll{overflow-x:auto}table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:.7rem;border-bottom:1px solid var(--border-cockpit);white-space:nowrap}th{font:.7rem var(--font-mono);color:var(--text-secondary)}.button{display:inline-block;padding:.7rem 1rem;border:1px solid var(--border-cockpit);border-radius:3px;text-decoration:none;color:var(--text-primary)}@media(max-width:700px){.totals{gap:1.5rem}}</style>

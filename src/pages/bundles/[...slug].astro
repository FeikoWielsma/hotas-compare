---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductHero from '../../components/detail/ProductHero.astro';
import Verdict from '../../components/detail/Verdict.astro';
import UseCaseFit from '../../components/detail/UseCaseFit.astro';
import Reviews from '../../components/detail/Reviews.astro';
import PriceTable from '../../components/detail/PriceTable.astro';
import UpgradePaths from '../../components/detail/UpgradePaths.astro';
import { resolveUpgradePaths } from '../../lib/upgrades';
import ProductCard from '../../components/ProductCard.svelte';
import ControlInventory from '../../components/ControlInventory.svelte';
import { getCatalogItems } from '../../lib/catalog';
import { productJsonLd } from '../../lib/structured-data';
import { inventoryComplete } from '../../lib/control-inventory';
import { cardItem } from '../../lib/catalog-ui';
import { overallVerdict, keySpecs, isDefaultFit } from '../../lib/detail';
const [components, bundles, brands, catalog] = await Promise.all([getCollection('components'), getCollection('bundles'), getCollection('brands'), getCatalogItems()]);
const brandMap = new Map(brands.map(x => [x.id, x.data]));
export async function getStaticPaths() { const bundles = await getCollection('bundles'); return bundles.map(({id,data}) => ({params:{slug:id},props:{bundle:{id,data}}})); }
const { bundle: entry } = Astro.props;
const { id, data: b } = entry;
const brand = brandMap.get(b.brand);
const brandName = brand?.name ?? b.brand;
const included = b.components.map(ref => components.find(x => x.id === ref)).filter(Boolean).map(x => x!.data);
const item = catalog.find(x => x.id === id)!;
const memberCards = b.components.map(ref => catalog.find(x => x.id === ref)).filter(Boolean);
const description = `${brandName} ${b.name} bundle contents and regional prices.`;
const jsonLd = productJsonLd(b, brandName, new URL(Astro.url.pathname, Astro.site), description);
const complete = inventoryComplete(included);
const specs = keySpecs({
  verdict: b.verdict ? overallVerdict(b.verdict) : null,
  axes: item.totalAxes || item.axisCountKnown ? String(item.totalAxes) : null,
  inputs: item.totalLogicalButtons || complete ? `${item.totalLogicalButtons}${complete ? '' : '+'}` : null,
});
specs.splice(b.verdict ? 1 : 0, 0, { label: 'In the box', value: `${b.components.length} component${b.components.length === 1 ? '' : 's'}` });
if (item.controlsSummary.ministickCount) specs.push({ label: 'Ministicks', value: String(item.controlsSummary.ministickCount) });
const showFit = !isDefaultFit(item.use_case_fit);
const upgrades = resolveUpgradePaths(id, b.upgrade_paths, new Map(components.map(x => [x.id, x.data])), new Map(bundles.map(x => [x.id, x.data])));
const showUpgrades = upgrades.length > 0 || !!item.needsPedals;
const sections = [
  b.verdict && { href: '#verdict', label: 'Verdict' }, { href: '#included', label: 'What’s included' }, { href: '#controls', label: 'Controls' },
  showFit && { href: '#fit', label: 'Flying-style fit' }, showUpgrades && { href: '#upgrades', label: 'Upgrade paths' }, { href: '#pricing', label: 'Pricing' }, b.external_reviews.length && { href: '#reviews', label: 'Reviews' },
].filter(Boolean) as { href: string; label: string }[];
---
<BaseLayout title={b.name} description={description} image={b.images[0]?.file} jsonLd={jsonLd}>
<div class="page">
  <ProductHero id={id} name={b.name} brand={b.brand} brandName={brandName} category={b.category} status={b.status} verification={b.verification}
    placement={item.placement} images={b.images} prices={b.prices} notes={brand?.landed_cost_notes} compatibility={b.platform_compatibility}
    specs={specs} crumb={{ href: '/#hardware', label: 'Bundles' }} sections={sections} />
  {b.verdict && <Verdict verdict={b.verdict} />}
  <section id="included" class="included" aria-labelledby="included-title">
    <p class="kicker">In the box</p><h2 id="included-title">What’s included</h2>
    <div class="cards">{memberCards.map(member => <ProductCard client:visible item={cardItem(member!)} compact />)}</div>
  </section>
  <div id="controls" class="anchor"><ControlInventory sections={included} /></div>
  {showFit && <UseCaseFit fit={item.use_case_fit} note="Editorial estimate from 1 (limited) to 5 (excellent), averaged across the included components." />}
  <UpgradePaths upgrades={upgrades} needsPedals={!!item.needsPedals} />
  <PriceTable prices={b.prices} notes={brand?.landed_cost_notes} />
  {b.external_reviews.length > 0 && <Reviews reviews={b.external_reviews} />}
</div>
</BaseLayout>
<style>
  .page { max-width: 1240px; margin: auto; min-width: 0; }
  .anchor, section { scroll-margin-top: 4rem; }
  .page > :global(section), .anchor { margin-bottom: 2.5rem; }
  .kicker { margin: 0; color: var(--color-accent); font-size: .8rem; font-weight: 600; }
  .included h2 { margin: .25rem 0 1.25rem; font-size: clamp(1.9rem, 3vw, 2.5rem); text-transform: uppercase; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem; }
</style>

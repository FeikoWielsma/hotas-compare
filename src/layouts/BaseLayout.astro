---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CompareTray from '../components/CompareTray.svelte';
import { isRegion, regionFromCountry } from '../lib/stores/region.svelte';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  canonicalUrl?: string | URL;
  jsonLd?: string | object;
  noindex?: boolean;
}
const {
  title = 'Flight sim hardware, compared',
  description = 'Compare flight sticks, throttles, yokes and rudder pedals. Independent specs, regional prices and community verdicts for your next cockpit.',
  image = '/social-card.png', canonical, canonicalUrl: suppliedCanonical, jsonLd, noindex = false,
} = Astro.props;
const pageTitle = `${title} | HOTAS // COMPARE`;
const canonicalUrl = new URL(suppliedCanonical ?? canonical ?? Astro.url.pathname, Astro.site ?? 'https://hotas.razortek.nl');
// Escape HTML-sensitive characters so catalog text cannot terminate the script element.
const structuredData = jsonLd == null ? undefined : JSON.stringify(typeof jsonLd === 'string' ? JSON.parse(jsonLd) : jsonLd).replace(/</g, '\\u003c');
const cookieRegion = Astro.cookies.get('hotas_region')?.value;
const initialRegion = isRegion(cookieRegion) ? cookieRegion : regionFromCountry(Astro.request.headers.get('CF-IPCountry'));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="HOTAS // COMPARE" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {image && <meta property="og:image" content={new URL(image, canonicalUrl)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, canonicalUrl)} />
    {structuredData && <script type="application/ld+json" set:html={structuredData} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      try { document.documentElement.classList.toggle('light', localStorage.getItem('hotas_theme') === 'light'); } catch {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Navbar initialRegion={initialRegion} />
    <main id="main-content" tabindex="-1" data-pagefind-body data-pagefind-ignore={noindex ? 'all' : undefined}><slot /></main>
    <Footer />
    <CompareTray client:load />
  </body>
</html>

---
import RegionSwitcher from './RegionSwitcher.svelte';
import type { Region } from '../lib/schema';
interface Props { initialRegion?: Region }
const { initialRegion } = Astro.props;
const links = [{ href: '/', label: 'Catalog' }, { href: '/compare', label: 'Compare' }, { href: '/brands', label: 'Brands' }, { href: '/wizard', label: 'Wizard' }];
---

<header class="navbar">
  <div class="nav-inner">
    <a class="brand" href="/" aria-label="HOTAS Compare home"><span class="reticle" aria-hidden="true">⊕</span> HOTAS <span class="slashes">//</span> COMPARE</a>
    <nav aria-label="Main navigation">
      {links.map(({ href, label }) => <a href={href} aria-current={Astro.url.pathname === href || Astro.url.pathname.startsWith(`${href}/`) ? 'page' : undefined}>{label}</a>)}
      <a href="https://github.com/FeikoWielsma/hotas-compare">GitHub <span aria-hidden="true">↗</span></a>
    </nav>
    <div class="tools">
      <RegionSwitcher initialRegion={initialRegion} client:load />
      <button type="button" id="theme-toggle" aria-label="Switch to light mode" aria-pressed="false">Light mode</button>
    </div>
  </div>
  <div class="status-line"><span><i aria-hidden="true"></i> FLIGHT CONTROL DATABASE</span><span>COMMUNITY INTELLIGENCE <span aria-hidden="true">//</span> EU · UK · US</span></div>
</header>

<script>
  function setupThemeToggle() {
    const button = document.querySelector<HTMLButtonElement>('#theme-toggle');
    if (!button) return;
    const update = () => {
      const light = document.documentElement.classList.contains('light');
      button.textContent = light ? 'Cockpit dark' : 'Light mode';
      button.setAttribute('aria-label', light ? 'Switch to cockpit dark mode' : 'Switch to light mode');
      button.setAttribute('aria-pressed', String(light));
    };
    update();
    button.onclick = () => {
      const light = document.documentElement.classList.toggle('light');
      try { localStorage.setItem('hotas_theme', light ? 'light' : 'dark'); } catch { /* Keep current page preference. */ }
      update();
    };
  }
  setupThemeToggle();
  document.addEventListener('astro:page-load', setupThemeToggle);
</script>

<style>
  .navbar { background: var(--bg-panel); border-bottom: 1px solid var(--border-cockpit); }
  .nav-inner { max-width: 1440px; margin: auto; padding: 1.2rem 2rem; display: flex; align-items: center; flex-wrap: wrap; gap: 1.5rem; }
  .brand { display: flex; align-items: center; gap: .5rem; font: 700 1rem var(--font-mono); letter-spacing: -.03em; text-decoration: none; white-space: nowrap; text-shadow: 0 0 20px var(--accent-amber-glow); }
  .reticle { color: var(--accent-amber); font-size: 1.8rem; margin-right: .25rem; } .slashes { color: var(--accent-amber); }
  nav { display: flex; align-items: center; gap: 1.2rem; flex-wrap: wrap; flex: 1; }
  nav a { color: var(--text-secondary); font-size: .8rem; text-decoration: none; white-space: nowrap; }
  nav a:hover, nav a[aria-current='page'] { color: var(--accent-amber-light); }
  nav a[aria-current='page'] { text-decoration: underline; text-underline-offset: .5rem; }
  .tools { display: flex; align-items: center; gap: .75rem; }
  button { color: var(--text-secondary); border: 1px solid var(--border-cockpit); border-radius: 3px; background: transparent; padding: .65rem; font: .7rem var(--font-mono); cursor: pointer; }
  button:hover { color: var(--accent-amber); }
  .status-line { border-top: 1px solid var(--border-cockpit); display: flex; justify-content: space-between; gap: 1rem; padding: .45rem max(2rem, calc((100% - 1376px) / 2)); font: .58rem var(--font-mono); color: var(--text-secondary); letter-spacing: .12em; }
  i { display: inline-block; width: 5px; height: 5px; border-radius: 50%; background: var(--accent-amber); margin-right: .5rem; box-shadow: 0 0 8px var(--accent-amber-glow); }
  @media (max-width: 800px) { .nav-inner { padding: 1rem; gap: 1rem; } nav { order: 3; flex-basis: 100%; gap: 1rem; } .tools { margin-left: auto; } .status-line { padding: .45rem 1rem; } .status-line > span:last-child { display: none; } }
  @media (max-width: 480px) { .tools { margin-left: 0; } .brand { flex-basis: 100%; } }
</style>

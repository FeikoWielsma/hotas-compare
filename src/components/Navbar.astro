---
import RegionSwitcher from './RegionSwitcher.svelte';
import SearchModal from './SearchModal.svelte';
import { getCatalogItems } from '../lib/catalog';
import { detailHref } from '../lib/catalog-ui';
import type { Region } from '../lib/schema';
/** `pageSearch`: the page has its own search box, so the header's search button is hidden (Ctrl+K still works). */
interface Props { initialRegion?: Region; pageSearch?: boolean }
const { initialRegion, pageSearch = false } = Astro.props;
const searchItems = (await getCatalogItems()).map(item => ({ name: item.name, brandName: item.brandName, category: item.category, yokePart: item.yokePart, prices: item.prices, formerBrandNames: item.formerBrandNames, image: item.images[0]?.file, url: detailHref(item) }));
const links = [{ href: '/', label: 'Catalog' }, { href: '/compare', label: 'Compare' }, { href: '/brands', label: 'Brands' }, { href: '/wizard', label: 'Setup guide' }];
---

<header class:list={["navbar", { "page-search": pageSearch }]}>
  <div class="nav-inner">
    <a class="brand" href="/" aria-label="HOTAS Compare home"><span class="wordmark">HOTAS<span>COMPARE</span></span></a>
    <nav aria-label="Main navigation">
      {links.map(({ href, label }) => <a href={href} aria-current={Astro.url.pathname === href || Astro.url.pathname.startsWith(`${href}/`) ? 'page' : undefined}>{label}</a>)}
    </nav>
    <div class="tools">
      <SearchModal initialItems={searchItems} initialRegion={initialRegion} client:load />
      <RegionSwitcher initialRegion={initialRegion} client:load />
      <button type="button" id="theme-toggle" aria-label="Switch to light mode" aria-pressed="false">Light mode</button>
    </div>
  </div>

</header>

<script>
  function setupThemeToggle() {
    const button = document.querySelector<HTMLButtonElement>('#theme-toggle');
    if (!button) return;
    const update = () => {
      const light = document.documentElement.classList.contains('light');
      button.textContent = light ? 'Dark mode' : 'Light mode';
      button.setAttribute('aria-label', light ? 'Switch to dark mode' : 'Switch to light mode');
      button.setAttribute('aria-pressed', String(light));
    };
    update();
    button.onclick = () => {
      const light = document.documentElement.classList.toggle('light');
      try { localStorage.setItem('hotas_theme', light ? 'light' : 'dark'); } catch { /* Keep current page preference. */ }
      update();
    };
  }
  setupThemeToggle();
  document.addEventListener('astro:page-load', setupThemeToggle);
</script>

<style>
  /* Navy bar on every page. Tokens are re-pointed for the header's own controls only (islands sit inside astro-island wrappers), so the search dialog keeps the page theme. */
  .navbar { background: var(--color-navy); }
  .brand, nav, #theme-toggle, .tools :global(:is(.search-trigger, .region-switcher)) { --color-ink: #f8f2e6; --color-muted: #c9d3da; --color-rule: #36506a; --color-accent: #f69b70; --color-paper: #192f43; --color-surface: #22394f; --color-accent-soft: #2a4258; }
  .nav-inner { max-width: 1240px; margin: auto; padding: .7rem 0; display: flex; align-items: center; gap: .5rem 2rem; }
  .brand { flex: none; text-decoration: none; }
  .wordmark { font: 700 1.6rem/.95 var(--font-display); letter-spacing: -.01em; color: var(--color-ink); }
  .wordmark > span { color: var(--color-accent); }
  nav { display: flex; gap: 1.4rem; align-items: center; min-width: 0; overflow-x: auto; scrollbar-width: none; }
  nav a { font-size: .875rem; text-decoration: none; color: var(--color-muted); white-space: nowrap; }
  nav a:hover, nav a[aria-current='page'] { color: var(--color-accent); }
  nav a[aria-current='page'] { text-decoration: underline; text-underline-offset: .4rem; font-weight: 600; }
  .tools { display: flex; align-items: center; gap: .4rem; margin-left: auto; }
  .page-search .tools :global(.search-trigger) { display: none; }
  .tools :global(.search-trigger) { min-height: 0; padding: .35rem .5rem; font-size: .7rem; white-space: nowrap; }
  .tools :global(.region-switcher) { padding: 2px; }
  .tools :global(.region-switcher button) { padding: .3rem .45rem; font-size: .7rem; }
  button { padding: .35rem .5rem; border: 1px solid var(--color-rule); border-radius: 2px; background: transparent; color: var(--color-muted); font-size: .7rem; white-space: nowrap; }
  button:hover { color: var(--color-accent); border-color: var(--color-accent); }
  @media (max-width: 1319px) { .nav-inner { margin-inline: 2.5rem; } }
  @media (max-width: 640px) { .nav-inner { margin-inline: 1rem; flex-wrap: wrap; padding: .6rem 0; gap: .4rem 1rem; } nav { order: 3; flex-basis: 100%; } }
</style>

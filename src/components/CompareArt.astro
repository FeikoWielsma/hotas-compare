---
/** Decorative stick-vs-throttle illustration for the compare page header. Original artwork. */
---
<div class="compare-art" aria-hidden="true">
<svg viewBox="0 0 360 220" xmlns="http://www.w3.org/2000/svg" focusable="false">
  <defs>
    <linearGradient id="ca-grip" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#f8b08c"/><stop offset=".55" stop-color="#f29368"/><stop offset="1" stop-color="#c9532b"/></linearGradient>
    <linearGradient id="ca-metal" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2c4558"/><stop offset="1" stop-color="#132535"/></linearGradient>
    <linearGradient id="ca-boot" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#1a2d3d"/><stop offset=".5" stop-color="#2f4a5e"/><stop offset="1" stop-color="#16293a"/></linearGradient>
    <linearGradient id="ca-rod" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#8a9aa6"/><stop offset=".5" stop-color="#e6ecef"/><stop offset="1" stop-color="#7d8d99"/></linearGradient>
    <pattern id="ca-grid" width="12" height="12" patternUnits="userSpaceOnUse"><path d="M12 0H0V12" fill="none" stroke="#76889622" stroke-width=".6"/></pattern>
  </defs>
  <rect width="360" height="220" fill="url(#ca-grid)"/>
  <g stroke="#f69b70" stroke-width="1.2" fill="none" opacity=".7"><path d="M8 20V8h12M352 20V8h-12M8 200v12h12M352 200v12h-12"/></g>
  <g font-family="ui-monospace,monospace" font-size="8" fill="#9fb0bc" letter-spacing="1"><text x="24" y="20">FIG.01</text><text x="300" y="20">FIG.02</text></g>

  <!-- Stick: base, bellows boot, shaft, grip -->
  <ellipse cx="92" cy="196" rx="58" ry="6" fill="#0a1824" opacity=".55"/>
  <path d="M38 192 L48 172 Q50 168 55 168 H129 Q134 168 136 172 L146 192 Z" fill="url(#ca-metal)" stroke="#f29368" stroke-width="1.3" stroke-linejoin="round"/>
  <path d="M50 174 H134" stroke="#f6ad88" stroke-width=".8" opacity=".5"/>
  <g fill="#0f2233" stroke="#8a9aa6" stroke-width=".8"><circle cx="50" cy="186" r="2.4"/><circle cx="134" cy="186" r="2.4"/></g>
  <g fill="#f8f2e6"><rect x="68" y="179" width="9" height="5" rx="1.5"/><rect x="81" y="179" width="9" height="5" rx="1.5"/><rect x="94" y="179" width="9" height="5" rx="1.5" fill="#ed7044"/><rect x="107" y="179" width="9" height="5" rx="1.5"/></g>
  <ellipse cx="92" cy="167" rx="30" ry="6" fill="#132535" stroke="#3c566a"/>
  <ellipse cx="92" cy="161" rx="23" ry="6" fill="url(#ca-boot)" stroke="#3c566a" stroke-width=".8"/>
  <ellipse cx="92" cy="155" rx="18" ry="5" fill="url(#ca-boot)" stroke="#3c566a" stroke-width=".8"/>
  <ellipse cx="92" cy="149.5" rx="13" ry="4" fill="url(#ca-boot)" stroke="#3c566a" stroke-width=".8"/>
  <rect x="87.5" y="128" width="9" height="22" rx="2" fill="url(#ca-rod)"/>
  <path d="M78 134 C72 120 70 106 72 94 C73 85 66 79 66 67 C66 52 78 42 93 42 C108 42 119 50 118 64 C117 72 112 78 111 86 C110 96 114 103 119 110 C123 117 120 124 113 126 L106 127 C105 130 105 132 104 135 Q91 139 78 134 Z" fill="url(#ca-grip)" stroke="#0f2233" stroke-width="1.6" stroke-linejoin="round"/>
  <path d="M72 70 C71 58 79 49 91 48" stroke="#ffe3d2" stroke-width="2" fill="none" stroke-linecap="round" opacity=".7"/>
  <path d="M111 112 C114 116 114 120 111 122" stroke="#ffe3d2" stroke-width="1.4" fill="none" stroke-linecap="round" opacity=".5"/>
  <g stroke="#a8461f" stroke-width="1.3" fill="none" stroke-linecap="round" opacity=".85"><path d="M73 106 C69 108 69 113 73 115"/><path d="M74 117 C70 119 70 124 74 126"/></g>
  <path d="M77 134 C85 131 97 131 104 134" stroke="#0f2233" stroke-width="1.2" fill="none" opacity=".5"/>
  <path d="M73 60 C75 51 85 47 94 47 C104 47 112 52 112 60 C107 64 79 65 73 60 Z" fill="#132535" stroke="#0f2233"/>
  <circle cx="84" cy="56" r="4.6" fill="#2c4558" stroke="#c1cbd3" stroke-width=".9"/><path d="M84 52.8V59.2M80.8 56H87.2" stroke="#c1cbd3" stroke-width="1"/>
  <circle cx="101" cy="55" r="3.8" fill="#2c4558" stroke="#c1cbd3" stroke-width=".9"/><circle cx="101" cy="55" r="1.3" fill="#c1cbd3"/>
  <circle cx="99" cy="71" r="3" fill="#ed7044" stroke="#0f2233"/>
  <path d="M73 84 C64 86 61 97 68 104 L72 101 C69 97 70 91 76 89 Z" fill="#d8e0e5" stroke="#0f2233" stroke-width="1.1"/>

  <!-- Compare marker -->
  <path d="M150 112 H210" stroke="#c1cbd3" stroke-width="1.2" stroke-dasharray="3 4"/>
  <path d="M156 106 L149 112 L156 118 M204 106 L211 112 L204 118" stroke="#c1cbd3" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  <circle cx="180" cy="112" r="14" fill="#192f43" stroke="#f69b70" stroke-width="1.3"/>
  <text x="180" y="116" text-anchor="middle" font-family="system-ui,sans-serif" font-weight="800" font-size="11" fill="#f69b70" letter-spacing=".5">VS</text>

  <!-- Throttle: housing, detent scale, twin levers -->
  <ellipse cx="270" cy="196" rx="62" ry="6" fill="#0a1824" opacity=".55"/>
  <path d="M212 192 L220 152 Q222 144 230 144 H310 Q318 144 320 152 L328 192 Z" fill="url(#ca-metal)" stroke="#f29368" stroke-width="1.3" stroke-linejoin="round"/>
  <path d="M224 150 H316" stroke="#f6ad88" stroke-width=".8" opacity=".5"/>
  <rect x="236" y="148" width="68" height="9" rx="4.5" fill="#0b1a27" stroke="#3c566a" stroke-width=".8"/>
  <g stroke="#f69b70" stroke-width="1" opacity=".8"><path d="M236 162v4M246 162v3M256 162v3M266 162v4M276 162v3M286 162v3M296 162v4"/></g>
  <g fill="#f8f2e6"><rect x="230" y="174" width="12" height="7" rx="2"/><rect x="246" y="174" width="12" height="7" rx="2"/><rect x="262" y="174" width="12" height="7" rx="2" fill="#ed7044"/></g>
  <rect x="284" y="172" width="4" height="11" rx="2" fill="url(#ca-rod)"/><rect x="296" y="172" width="4" height="11" rx="2" fill="url(#ca-rod)"/><circle cx="286" cy="171" r="2.6" fill="#d8e0e5"/><circle cx="298" cy="171" r="2.6" fill="#d8e0e5"/>
  <path d="M258 152 L250 104" stroke="url(#ca-rod)" stroke-width="6" stroke-linecap="round"/>
  <path d="M283 152 L277 100" stroke="url(#ca-rod)" stroke-width="6" stroke-linecap="round"/>
  <g transform="rotate(-9 247 92)"><rect x="231" y="80" width="33" height="25" rx="8" fill="url(#ca-grip)" stroke="#0f2233" stroke-width="1.5"/><path d="M236 85 H258" stroke="#ffe3d2" stroke-width="1.8" stroke-linecap="round" opacity=".7"/><circle cx="241" cy="94" r="3.4" fill="#2c4558" stroke="#c1cbd3" stroke-width=".9"/><rect x="249" y="91" width="9" height="6" rx="2" fill="#f8f2e6"/></g>
  <g transform="rotate(-7 280 88)"><rect x="264" y="76" width="33" height="25" rx="8" fill="url(#ca-grip)" stroke="#0f2233" stroke-width="1.5"/><path d="M269 81 H291" stroke="#ffe3d2" stroke-width="1.8" stroke-linecap="round" opacity=".7"/><circle cx="288" cy="90" r="3.6" fill="#2c4558" stroke="#c1cbd3" stroke-width=".9"/><path d="M288 87.2V92.8M285.2 90H290.8" stroke="#c1cbd3" stroke-width=".9"/><circle cx="274" cy="90" r="2.6" fill="#ed7044" stroke="#0f2233" stroke-width=".8"/></g>

  <g font-family="ui-monospace,monospace" font-size="8.5" fill="#c1cbd3" letter-spacing="2" text-anchor="middle"><text x="92" y="212">STICK</text><text x="270" y="212">THROTTLE</text></g>
</svg>
</div>
<style>
  .compare-art { position: relative; width: min(360px, 80vw); padding: .85rem; border: 1px solid #768896; transform: rotate(-4deg); }
  .compare-art::before { content: ''; position: absolute; inset: 6px; border: 1px dashed #76889655; pointer-events: none; }
  svg { display: block; width: 100%; height: auto; }
  @media (prefers-reduced-motion: no-preference) { .compare-art { transition: transform .4s ease; } .compare-art:hover { transform: rotate(-2deg) scale(1.02); } }
</style>

---
interface Props { eyebrow: string; title: string; emphasis?: string; description?: string }
const { eyebrow, title, emphasis, description } = Astro.props;
---
<header class="journal-header">
  <div class="journal-copy"><p class="journal-eyebrow">{eyebrow}</p><h1>{title}{emphasis && <><br /><span>{emphasis}</span></>}</h1>{description && <p class="journal-description">{description}</p>}</div>
  {Astro.slots.has('art') && <div class="journal-art"><slot name="art" /></div>}
</header>
<style>
  .journal-header { position: relative; display: flex; justify-content: space-between; align-items: center; gap: 2rem; padding: clamp(1.75rem, 4vw, 3rem); margin-bottom: 2.5rem; background: var(--color-navy); color: var(--color-on-navy); overflow: hidden; }
  .journal-header::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 7px; background: repeating-linear-gradient(120deg,var(--color-highlight) 0 26px,#f5f2e9 26px 31px,var(--color-navy) 31px 43px); }
  .journal-copy { min-width: 0; } .journal-eyebrow { color: #f6ad88; font-size: .8rem; font-weight: 500; margin: 0 0 1.2rem; }
  h1 { color: var(--color-on-navy); font: 700 clamp(2.75rem, 6vw, 5.5rem)/.95 var(--font-display); text-transform: uppercase; margin: 0; letter-spacing: -.015em; }
  h1 span { color: #f69b70; } .journal-description { color: #d8e0e5; font-size: 1rem; line-height: 1.8; max-width: 56ch; margin: 1.3rem 0 0; }
  .journal-art { flex: none; } @media(max-width:600px) { .journal-header { flex-direction: column; align-items: start; gap: 1.5rem; } h1 { font-size: clamp(2.6rem, 11vw, 4rem); } .journal-description { font-size: .9rem; } }
</style>

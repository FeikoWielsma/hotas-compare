---
import { getCollection } from 'astro:content';
import type { ExternalReview } from '../../lib/schema';
interface Props { reviews: ExternalReview[] }
const { reviews } = Astro.props;
const reviewerMap = new Map((await getCollection('reviewers')).map(x => [x.id, x.data]));
const tags = { recommended: 'Recommended', mixed: 'Mixed', avoid: 'Avoid', neutral: 'Neutral' } as const;
---
<section id="reviews" class="reviews" aria-labelledby="reviews-title">
  <p class="kicker">Second opinions</p><h2 id="reviews-title">External reviews</h2>
  <div class="list">{reviews.map(r => { const who = reviewerMap.get(r.reviewer); return <article>
    <header><a href={r.url} rel="external noopener">{who?.name ?? r.reviewer} ↗</a><span class={`tag ${r.tag}`}>{tags[r.tag]}</span></header>
    <p>{r.summary}</p>
    <small>{who?.platform ?? 'External review'} · {r.date}</small>
  </article>; })}</div>
</section>
<style>
  .reviews { padding-top: 1.5rem; border-top: 1px solid var(--color-rule); scroll-margin-top: 4rem; }
  .kicker { margin: 0; color: var(--color-accent); font-size: .8rem; font-weight: 600; }
  h2 { margin: .25rem 0 1.25rem; font-size: clamp(1.9rem, 3vw, 2.5rem); text-transform: uppercase; }
  .list { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1rem; }
  article { padding: 1.25rem; border: 1px solid var(--color-rule); background: var(--color-surface); }
  header { display: flex; justify-content: space-between; gap: .75rem; align-items: baseline; } header a { font-weight: 600; color: var(--color-ink); }
  .tag { font-size: .75rem; font-weight: 600; padding: .15rem .5rem; border: 1px solid var(--color-rule); color: var(--color-muted); }
  .tag.recommended { color: var(--color-success); border-color: color-mix(in srgb, var(--color-success) 40%, transparent); } .tag.avoid { color: var(--color-danger); border-color: color-mix(in srgb, var(--color-danger) 40%, transparent); }
  p { font-size: .9rem; line-height: 1.6; margin: .75rem 0; } small { font-size: .75rem; color: var(--color-muted); }
</style>

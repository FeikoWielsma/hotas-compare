---
import type { Verdict } from '../../lib/schema';
import { humanize } from '../../lib/labels';
import Pips from './Pips.astro';
interface Props { verdict: Verdict }
const { verdict: v } = Astro.props;
const scores = v.scores ? [['Build', v.scores.build], ['Feel', v.scores.feel], ['Value', v.scores.value], ['Software', v.scores.software], ['QC & support', v.scores.qc_support]] as const : [];
const overall = scores.length ? scores.reduce((n, [, s]) => n + s, 0) / scores.length : null;
---
<section id="verdict" class="verdict" class:list={{ unscored: !v.scores }} aria-labelledby="verdict-title">
  <div class="take">
    <p class="kicker">{v.hands_on ? 'Hands-on verdict' : 'Assessment from the specifications'}</p>
    <h2 id="verdict-title">The verdict</h2>
    <blockquote>{v.take.replace(/^Draft assessment:\s*/i, '')}</blockquote>
    <p class="byline">— {v.author}{v.hands_on && v.owned_hours != null && ` · ${v.owned_hours} hours owned`}{!v.hands_on && ' · not tested in person'}</p>
    {(v.pros.length > 0 || v.cons.length > 0) && <div class="pc">
      {v.pros.length > 0 && <div><h3>What’s good</h3><ul class="pros">{v.pros.map(x => <li>{x}</li>)}</ul></div>}
      {v.cons.length > 0 && <div><h3>Watch out for</h3><ul class="cons">{v.cons.map(x => <li>{x}</li>)}</ul></div>}
    </div>}
    {(v.great_for.length > 0 || v.skip_if.length > 0) && <dl class="fit">
      {v.great_for.length > 0 && <div><dt>Great for</dt><dd>{v.great_for.map(x => <span class="chip good">{humanize(x)}</span>)}</dd></div>}
      {v.skip_if.length > 0 && <div><dt>Skip if</dt><dd>{v.skip_if.map(x => <span class="chip">{humanize(x)}</span>)}</dd></div>}
    </dl>}
  </div>
  {v.scores && <div class="scores">
    <p class="overall"><strong>{Number(overall!.toFixed(1))}</strong><span>/ 5 overall</span></p>
    <dl>{scores.map(([label, value]) => <div><dt>{label}</dt><dd><Pips value={value} label={label} /><b>{value}</b></dd></div>)}</dl>
  </div>}
</section>
<style>
  .verdict { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 2.5rem; padding: 2rem; background: var(--color-surface); border: 1px solid var(--color-rule); }
  .verdict.unscored { grid-template-columns: 1fr; }
  .kicker { margin: 0; color: var(--color-accent); font-size: .8rem; font-weight: 600; }
  h2 { margin: .25rem 0 1rem; font-size: clamp(1.9rem, 3vw, 2.5rem); text-transform: uppercase; }
  blockquote { margin: 0; font-size: 1.15rem; line-height: 1.6; text-wrap: pretty; }
  .byline { margin: .75rem 0 0; color: var(--color-muted); font-size: .875rem; }
  .pc { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 1.5rem; }
  h3 { margin: 0 0 .5rem; font-size: .875rem; font-weight: 700; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .45rem; font-size: .9rem; line-height: 1.5; }
  li { position: relative; padding-left: 1.4rem; }
  .pros li::before, .cons li::before { position: absolute; left: 0; font-weight: 700; }
  .pros li::before { content: '+'; color: var(--color-success); } .cons li::before { content: '–'; color: var(--color-danger); }
  .fit { display: grid; gap: .6rem; margin: 1.5rem 0 0; } .fit div { display: flex; flex-wrap: wrap; align-items: baseline; gap: .5rem; } .fit dt { width: 5.5rem; font-size: .8125rem; color: var(--color-muted); } .fit dd { margin: 0; display: flex; flex-wrap: wrap; gap: .35rem; flex: 1; }
  .chip { padding: .2rem .55rem; border: 1px solid var(--color-rule); font-size: .8rem; } .chip.good { border-color: color-mix(in srgb, var(--color-success) 45%, transparent); color: var(--color-success); }
  .scores { border-left: 1px solid var(--color-rule); padding-left: 2rem; }
  .overall { display: flex; align-items: baseline; gap: .5rem; margin: 0 0 1.25rem; } .overall strong { font: 700 3.5rem/1 var(--font-display); color: var(--color-accent); } .overall span { color: var(--color-muted); font-size: .875rem; }
  .scores dl { display: grid; gap: .75rem; margin: 0; } .scores dt { font-size: .8125rem; color: var(--color-muted); margin-bottom: .25rem; } .scores dd { display: grid; grid-template-columns: 1fr 1.5rem; align-items: center; gap: .75rem; margin: 0; } .scores b { font-variant-numeric: tabular-nums; text-align: right; }
  @media (max-width: 800px) { .verdict { grid-template-columns: 1fr; padding: 1.25rem; gap: 1.5rem; } .scores { border-left: 0; padding-left: 0; border-top: 1px solid var(--color-rule); padding-top: 1.25rem; } .pc { grid-template-columns: 1fr; } }
</style>
